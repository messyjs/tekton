{
  "name": "tekton-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/voice",
    "packages/tools",
    "packages/hermes-bridge",
    "packages/gateway",
    "packages/dashboard",
    "packages/ml-ops",
    "packages/forge",
    "packages/cli",
    "packages/pi-agent-service"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build -w @tekton/core -w @tekton/hermes-bridge -w @tekton/tools -w @tekton/voice -w @tekton/gateway -w @tekton/dashboard -w @tekton/ml-ops -w @tekton/docling-service",
    "build:cli": "npm run build -w @tekton/cli",
    "build:forge": "npm run build -w @tekton/forge",
    "test": "vitest run",
    "pi-agent": "node packages/pi-agent-service/dist/cli.js --mode http --port 7706",
    "clean": "rm -rf packages/*/dist"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "node-pty": "^1.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.0",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "koffi": "^2.16.1",
    "midi": "^2.0.0"
  }
}
